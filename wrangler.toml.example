# ============================================================
# 卡密资源分发系统 v1.0.4 —— wrangler 本地调试配置参考
# 用法: cp wrangler.toml.example wrangler.toml 并填入真实 ID
# 注意: Pages 线上部署的绑定在控制台配置（Settings → Bindings），
#       此文件仅用于 wrangler pages dev 本地调试；
#       GitHub Actions 部署时会自动生成 wrangler.toml（无需手工维护）。
# ============================================================
name = "cards-download"
compatibility_date = "2025-01-01"
pages_build_output_dir = "public"

[[d1_databases]]
binding = "DATABASE"                       # 必须叫 DATABASE
database_name = "cards"                    # 改成你的 D1 数据库名
database_id = "<你的 D1 database_id>"

[[r2_buckets]]
binding = "BUCKET"                         # 必须叫 BUCKET
bucket_name = "cards-scripts"              # 改成你的 R2 桶名

# 本地调试时模拟线上 Secret（线上在 Pages 控制台配置，不要提交到 git）
[vars]
# ADMIN_SECRET = "本地调试用管理密钥"
# JWT_SECRET = "/s/ 加密分享链接加解密密钥（可选；未配置自动退回用 ADMIN_SECRET 派生）"
# ISSUE_APIKEY = "本地调试用发卡密钥（旧版单密钥；建议用管理面板 APIKEY 管理）"
