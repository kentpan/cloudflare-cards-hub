# ============================================================
# 卡密资源分发系统 v1.0.3 —— 沙盒本地运行环境变量参考
# 用法: cp .env.example .env 后按需修改
# 说明: 本文件等价于 Cloudflare Pages「运行环境变量」；
#       线上部署时请在 Pages 控制台（或 GitHub Secrets 自动注入）配置，
#       .env 只影响沙盒本地运行（local/dev-server.mjs / local/daemon.mjs）。
# ============================================================

# 管理面板登录密钥（必填，长随机字符串；管理面板 /admin 用它登录）
ADMIN_SECRET=cards-admin-local-2024

# /s/ 加密分享链接的加解密密钥（可选；未配置时退回用 ADMIN_SECRET 派生。
# 生产环境务必单独配置长随机串，如 openssl rand -hex 24 生成）
# JWT_SECRET=

# 沙盒本地 SQLite 数据库文件（Prisma 风格 file: URI；相对路径基于项目根目录）
DATABASE_URI=file:./prisma/cards-download.db

# 发卡接口旧版单密钥（可选；建议在管理面板「APIKEY 管理」创建多把 key）
# ISSUE_APIKEY=

# 本地服务端口（默认 3000）
# PORT=3000
